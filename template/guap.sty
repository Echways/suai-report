\AtBeginEnvironment{tabular}{\singlespacing}
\AtBeginEnvironment{tabularx}{\singlespacing}
\AtBeginEnvironment{longtable}{\singlespacing}

%%---------------------------------------------------------------------
%%  8. ПЕРЕЧИСЛЕНИЯ (ГОСТ 2.105: дефис либо строчная буква со скобкой,
%%     буквы ё, з, й, о, ч, ъ, ы, ь не используются)
%%---------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{nosep,topsep=0pt,partopsep=0pt,parsep=0pt,itemsep=0pt,
         leftmargin=*,labelindent=\parindent,labelsep=0.5em,align=left}
\setlist[itemize,1]{label={--}}
\setlist[itemize,2]{label={--},labelindent=2cm}
\setlist[enumerate,1]{label=\arabic*)}

\makeatletter
\newcommand{\@gostletter}[1]{%
  \ifcase#1\relax\or а\or б\or в\or г\or д\or е\or ж\or и\or к\or л\or
  м\or н\or п\or р\or с\or т\or у\or ф\or х\or ц\or ш\or щ\or э\or ю\or я\fi}
\newcommand{\gostletter}[1]{\expandafter\@gostletter\csname c@#1\endcsname}
\AddEnumerateCounter{\gostletter}{\@gostletter}{я}
\makeatother

\newlist{gostenum}{enumerate}{2}
\setlist[gostenum,1]{label=\gostletter*),labelindent=\parindent}
\setlist[gostenum,2]{label=\arabic*),labelindent=2cm}

%%---------------------------------------------------------------------
%%  9. ЛИСТИНГИ КОДА
%%---------------------------------------------------------------------
%% Подпись листинга формирует сам listings (captionpos=t):
%% «Листинг 1 – Название», по центру над кодом.
\renewcommand{\lstlistingname}{Листинг}

\definecolor{guapFrame}{HTML}{B5B5B5}
\definecolor{guapKeyword}{HTML}{0B4F9E}
\definecolor{guapComment}{HTML}{5C7A5C}
\definecolor{guapString}{HTML}{A03030}
\definecolor{guapBack}{HTML}{FAFAFA}

% Ч/б стиль — безопасен для печати и нормоконтроля
\lstdefinestyle{gost}{
  basicstyle=\ttfamily\fontsize{12}{14}\selectfont,
  numbers=left, numberstyle=\ttfamily\fontsize{10}{12}\selectfont,
  numbersep=10pt, stepnumber=1,
  frame=single, rulecolor=\color{guapFrame}, framesep=5pt,
  breaklines=true, breakatwhitespace=true,
  postbreak=\mbox{\textcolor{guapFrame}{$\hookrightarrow$}\space},
  showstringspaces=false, tabsize=4, columns=fullflexible,
  keepspaces=true, extendedchars=true, upquote=true,
  captionpos=t, aboveskip=10pt, belowskip=10pt,
  xleftmargin=\parindent, xrightmargin=0pt,
  keywordstyle=\bfseries, commentstyle=\itshape,
  stringstyle=\normalfont\ttfamily,
}
% Цветной стиль — для электронной версии: \lstset{style=gostcolor}
\lstdefinestyle{gostcolor}{
  style=gost,
  backgroundcolor=\color{guapBack},
  keywordstyle=\bfseries\color{guapKeyword},
  commentstyle=\itshape\color{guapComment},
  stringstyle=\color{guapString},
}
\lstset{style=gost}

