%%---------------------------------------------------------------------
%%  1. ШРИФТЫ
%%  Times New Roman нет в базовой установке Overleaf, поэтому есть
%%  автоподмена на TeX Gyre Termes (метрически идентичен TNR).
%%  Чтобы получить настоящий TNR: загрузите times.ttf/timesbd.ttf/
%%  timesi.ttf/timesbi.ttf в папку fonts/ и раскомментируйте блок ниже.
%%---------------------------------------------------------------------
\RequirePackage{fontspec}
\defaultfontfeatures[\rmfamily,\sffamily]{Ligatures=TeX} % в коде кавычки остаются прямыми

% \setmainfont{Times New Roman}[
%   Path            = ./fonts/,
%   Extension       = .ttf,
%   UprightFont     = times,
%   BoldFont        = timesbd,
%   ItalicFont      = timesi,
%   BoldItalicFont  = timesbi ]

%% Цепочка: Times New Roman -> TeX Gyre Termes -> Liberation Serif.
%% Все три метрически совместимы и содержат кириллицу.
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\IfFontExistsTF{LiberationSerif-Regular.ttf}
     {\setmainfont{Liberation Serif}}
     {\setmainfont{TeX Gyre Termes}}}
\IfFontExistsTF{LiberationSans-Regular.ttf}
  {\setsansfont{Liberation Sans}}
  {\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{LiberationMono-Regular.ttf}
  {\setmonofont{Liberation Mono}[Scale=MatchLowercase]}
  {\setmonofont{TeX Gyre Cursor}[Scale=MatchLowercase]}

\RequirePackage[english,russian]{babel}

