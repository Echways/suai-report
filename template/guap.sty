%% Удобные сокращения для ссылок в тексте.
%% Префикс метки можно не писать: \figref{scheme} = \figref{fig:scheme}
\newcommand{\guapref}[2]{\@ifundefined{r@#2}{\ref{#1:#2}}{\ref{#2}}}
\newcommand{\figref}[1]{рисунке~\guapref{fig}{#1}}
\newcommand{\tabref}[1]{таблице~\guapref{tab}{#1}}
\newcommand{\lstref}[1]{листинге~\guapref{lst}{#1}}
\newcommand{\formref}[1]{формуле~(\guapref{eq}{#1})}

%%---------------------------------------------------------------------
%% 15. БЫСТРЫЕ ВСТАВКИ
%%  \guapimg[ширина]{файл}{подпись}[метка]   метка по умолчанию fig:имя-файла
%%  \guapcode[язык]{файл}{подпись}[метка]    метка по умолчанию lst:файл
%%    файл кода ищется как есть, затем в code/:  \guapcode[Python]{main.py}{...}
%%---------------------------------------------------------------------
\ExplSyntaxOn
\str_new:N \l__guap_dir_str
\str_new:N \l__guap_name_str
\str_new:N \l__guap_ext_str
% метка из имени файла без папки и расширения: images/scheme.png -> fig:scheme
\cs_new_protected:cpn { guap@autolabel } #1#2
  {
    \file_parse_full_name:nNNN {#2}
      \l__guap_dir_str \l__guap_name_str \l__guap_ext_str
    \use:x { \exp_not:N \label { #1 : \l__guap_name_str } }
  }
\ExplSyntaxOff

\NewDocumentCommand{\guapimg}{O{0.8\textwidth} m m o}{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#1,height=0.75\textheight,keepaspectratio]{#2}%
    \caption{#3}%
    \IfNoValueTF{#4}{\guap@autolabel{fig}{#2}}{\label{#4}}%
  \end{figure}}

\NewDocumentCommand{\guapcode}{O{} m m o}{%
  \IfFileExists{#2}{\def\guap@codefile{#2}}{\def\guap@codefile{code/#2}}%
  \IfNoValueTF{#4}{\def\guap@codelabel{lst:#2}}{\def\guap@codelabel{#4}}%
  \lstinputlisting[language={#1},caption={#3},label=\guap@codelabel]%
    {\guap@codefile}}

%%---------------------------------------------------------------------
%% 16. ФАСАД: ПИШИ ТОЛЬКО ТЕКСТ
%%  Блочные команды читают строки под собой до ПУСТОЙ строки:
%%
%%    \guaptasks                          \guaptable[bench]{Параметры стенда}
%%    изучить интерфейс                   Параметр  | Значение
%%    настроить синхронизацию             Процессор | 8 ядер
%%                                        Память    | 16 ГБ
%%
%%  Блок также заканчивается сам, если следующая строка начинается
%%  с \section, \begin, \end или любой команды \guap...
%%---------------------------------------------------------------------
\RequirePackage{xltabular}
\setlength{\LTcapwidth}{\textwidth}

\newcommand{\guapintro}{\guapsection{Введение}}
\newcommand{\guapconclusion}{\guapsection{Заключение}}

\ExplSyntaxOn
\seq_new:N \g__guap_lines_seq
\tl_new:N \g__guap_then_tl
\bool_new:N \l__guap_cmd_bool
\str_new:N \l__guap_cmd_str
\cs_new_protected:Npn \__guap_eol: { }   % значение активного ^^M внутри блока

%% \guap_read_lines:n {код} — собрать строки в \g__guap_lines_seq и выполнить код
\cs_new_protected:Npn \guap_read_lines:n #1
  {
    \tl_gset:Nn \g__guap_then_tl {#1}
    \seq_gclear:N \g__guap_lines_seq
    \group_begin:
      \char_set_catcode_active:n { 13 }
      \__guap_lines_start:
  }
%% #1 — токены, которые вернуть во входной поток после блока
\cs_new_protected:Npn \__guap_lines_stop:n #1
  { \group_end: \tl_use:N \g__guap_then_tl #1 }

%% Активный конец строки нельзя набрать в коде напрямую: \lowercase
%% превращает активную ~ в активный ^^M.
\group_begin:
  \char_set_lccode:nn { `\~ } { 13 }
  \char_set_catcode_active:N \~
  \tex_lowercase:D
    {
      \group_end:
      \cs_new_protected:Npn \__guap_lines_start:
        {
          \cs_set_eq:NN ~ \__guap_eol:
          \peek_meaning_remove:NTF \par
            { \__guap_lines_stop:n { \par } }
            { \peek_meaning_remove:NTF \__guap_eol: { \__guap_line:w } { \__guap_line:w } }
        }
      \cs_new_protected:Npn \__guap_line:w #1 ~
        { \tl_trim_spaces_apply:nN {#1} \__guap_line:n }
    }

\cs_new_protected:Npn \__guap_line:n #1
  {
    \tl_if_blank:nTF {#1}
      { \__guap_lines_stop:n { \par } }
      {
        \bool_set_false:N \l__guap_cmd_bool
        \tl_if_head_is_N_type:nT {#1} { \__guap_check_cmd:w #1 \q_stop }
        \bool_if:NTF \l__guap_cmd_bool
          { \__guap_lines_stop:n {#1} }
          {
            \seq_gput_right:Nn \g__guap_lines_seq {#1}
            \__guap_line:w
          }
      }
  }

%% строка, начинающаяся с «структурной» команды, завершает блок
\cs_new_protected:Npn \__guap_check_cmd:w #1 #2 \q_stop
  {
    \token_if_cs:NT #1
      {
        \str_set:Nx \l__guap_cmd_str { \cs_to_str:N #1 }
        \exp_args:NV \str_case:nnT \l__guap_cmd_str
          {
            { par } { } { begin } { } { end } { } { section } { }
            { subsection } { } { subsubsection } { } { paragraph } { }
            { clearpage } { } { newpage } { } { maketitle } { }
            { printbibliography } { }
          }
          { \bool_set_true:N \l__guap_cmd_bool }
        \exp_args:Nx \str_if_eq:nnT
          { \str_range:Nnn \l__guap_cmd_str { 1 } { 4 } } { guap }
          { \bool_set_true:N \l__guap_cmd_bool }
      }
  }

%%---------------------------------------------------------------------
%% Перечисления: ; в конце пунктов и . в конце последнего ставятся сами
%%---------------------------------------------------------------------
\bool_new:N \l__guap_punct_bool
\tl_new:N \l__guap_item_tl
\regex_const:Nn \c__guap_trail_regex { [\;\.\,] \s* \Z }
\regex_const:Nn \c__guap_keep_regex { [\?\!\:] \s* \Z }

\cs_new_protected:Npn \__guap_punct:n #1
  {
    \bool_if:NT \l__guap_punct_bool
      {
        \regex_replace_once:NnN \c__guap_trail_regex { } \l__guap_item_tl
        \exp_args:NNV \regex_match:NnF \c__guap_keep_regex \l__guap_item_tl
          {
            \tl_put_right:Nx \l__guap_item_tl
              {
                \int_compare:nNnTF {#1} = { \seq_count:N \g__guap_lines_seq }
                  { . } { ; }
              }
          }
      }
  }

%% #1 — окружение, #2 — булево «без пунктуации» (звёздочка)
\cs_new_protected:Npn \__guap_list:nn #1#2
  {
    \seq_if_empty:NF \g__guap_lines_seq
      {
        \bool_set:Nn \l__guap_punct_bool { ! #2 }
        \begin{#1}
          \seq_map_indexed_function:NN \g__guap_lines_seq \__guap_list_item:nn
        \end{#1}
      }
  }
\cs_new_protected:Npn \__guap_list_item:nn #1#2
  {
    \tl_set:Nn \l__guap_item_tl {#2}
    \__guap_punct:n {#1}
    \item \tl_use:N \l__guap_item_tl
  }

\NewDocumentCommand \guaplist { s }
  { \guap_read_lines:n { \__guap_list:nn { itemize } {#1} } }
\NewDocumentCommand \guapenum { s }
  { \guap_read_lines:n { \__guap_list:nn { gostenum } {#1} } }
\NewDocumentCommand \guapnum { s }
  { \guap_read_lines:n { \__guap_list:nn { enumerate } {#1} } }
\NewDocumentCommand \guaptasks
  { s O{Для~достижения~поставленной~цели~необходимо~решить~следующие~задачи:} }
  {
    \guap_read_lines:n
      {
        \tl_if_blank:nF {#2} { \par #2 \par }
        \__guap_list:nn { gostenum } {#1}
      }
  }

%%---------------------------------------------------------------------
%% Таблица: ячейки через |, первая строка — шапка.
%% Ширины столбцов подбираются по длине текста, длинная таблица
%% переносится на следующую страницу с «Продолжение таблицы N».
%%---------------------------------------------------------------------
\int_new:N \l__guap_cols_int
\prop_new:N \l__guap_width_prop
\seq_new:N \l__guap_cells_seq
\fp_new:N \l__guap_sum_fp
\tl_new:N \l__guap_spec_tl
\tl_new:N \l__guap_head_tl
\tl_new:N \l__guap_body_tl
\tl_new:N \l__guap_row_tl
\tl_new:N \l__guap_table_tl

\cs_new:Npn \__guap_width:n #1
  { \int_max:nn { 4 } { \int_min:nn { 40 } { \prop_item:Nn \l__guap_width_prop {#1} } } }

\cs_new_protected:Npn \__guap_table_measure:n #1
  {
    \seq_set_split:Nnn \l__guap_cells_seq { | } {#1}
    \int_set:Nn \l__guap_cols_int
      { \int_max:nn { \l__guap_cols_int } { \seq_count:N \l__guap_cells_seq } }
    \seq_map_indexed_function:NN \l__guap_cells_seq \__guap_table_measure:nn
  }
\cs_new_protected:Npn \__guap_table_measure:nn #1#2
  {
    \prop_put:Nnx \l__guap_width_prop {#1}
      { \int_max:nn { 0 \prop_item:Nn \l__guap_width_prop {#1} } { \str_count:n {#2} } }
  }

\cs_new_protected:Npn \__guap_table_spec:n #1
  {
    \tl_put_right:Nx \l__guap_spec_tl
      {
        | > {
          \exp_not:N \hsize =
            \fp_eval:n { round ( \l__guap_cols_int * \__guap_width:n {#1} / \l__guap_sum_fp , 4 ) }
            \exp_not:N \hsize
          \exp_not:N \linewidth = \exp_not:N \hsize
          \int_compare:nNnTF {#1} = { 1 }
            { \exp_not:N \raggedright } { \exp_not:N \centering }
          \exp_not:N \arraybackslash
        } X
        \int_compare:nNnT {#1} = { \l__guap_cols_int } { | }
      }
  }

\cs_new_protected:Npn \__guap_table_row:nn #1#2
  {
    \seq_set_split:Nnn \l__guap_cells_seq { | } {#2}
    \tl_clear:N \l__guap_row_tl
    \int_step_inline:nn { \l__guap_cols_int }
      {
        \tl_put_right:Nx \l__guap_row_tl
          {
            \int_compare:nNnF {##1} = { 1 } { & }
            \int_compare:nNnT {#1} = { 1 }
              { \exp_not:N \centering \exp_not:N \bfseries }
            \seq_item:Nn \l__guap_cells_seq {##1}
          }
      }
    \tl_put_right:Nn \l__guap_row_tl { \tabularnewline \hline }
    \int_compare:nNnTF {#1} = { 1 }
      { \tl_set_eq:NN \l__guap_head_tl \l__guap_row_tl }
      { \tl_put_right:NV \l__guap_body_tl \l__guap_row_tl }
  }

%% #1 — метка (без tab:), #2 — название
\cs_new_protected:Npn \__guap_table:nn #1#2
  {
    \seq_if_empty:NF \g__guap_lines_seq
      {
        \int_zero:N \l__guap_cols_int
        \prop_clear:N \l__guap_width_prop
        \seq_map_function:NN \g__guap_lines_seq \__guap_table_measure:n
        \fp_zero:N \l__guap_sum_fp
        \int_step_inline:nn { \l__guap_cols_int }
          { \fp_add:Nn \l__guap_sum_fp { \__guap_width:n {##1} } }
        \tl_clear:N \l__guap_spec_tl
        \int_step_function:nN { \l__guap_cols_int } \__guap_table_spec:n
        \tl_clear:N \l__guap_head_tl
        \tl_clear:N \l__guap_body_tl
        \seq_map_indexed_function:NN \g__guap_lines_seq \__guap_table_row:nn
        \tl_set:Nx \l__guap_table_tl
          {
            \exp_not:N \begin{xltabular}{\exp_not:N \textwidth}{\exp_not:V \l__guap_spec_tl}
            \exp_not:N \caption{\exp_not:n {#2}}
            \tl_if_blank:nF {#1} { \exp_not:N \label{tab:\exp_not:n {#1}} }
            \exp_not:N \tabularnewline
            \exp_not:N \hline
            \exp_not:V \l__guap_head_tl
            \exp_not:N \endfirsthead
            \exp_not:N \multicolumn{\int_use:N \l__guap_cols_int}{@{}l}
              {Продолжение~таблицы~\exp_not:N \thetable}
            \exp_not:N \tabularnewline
            \exp_not:N \hline
            \exp_not:V \l__guap_head_tl
            \exp_not:N \endhead
            \exp_not:V \l__guap_body_tl
            \exp_not:N \end{xltabular}
          }
        \tl_use:N \l__guap_table_tl
      }
  }

\NewDocumentCommand \guaptable { O{} m }
  { \guap_read_lines:n { \__guap_table:nn {#1} {#2} } }

%%---------------------------------------------------------------------
%% Формула с пояснениями «где ...»: строки «обозначение | смысл»
%%---------------------------------------------------------------------
\box_new:N \l__guap_where_box
\tl_new:N \l__guap_sym_tl

\cs_new_protected:Npn \__guap_where_item:nn #1#2
  {
    \seq_set_split:Nnn \l__guap_cells_seq { | } {#2}
    \int_compare:nNnTF { \seq_count:N \l__guap_cells_seq } > { 1 }
      {
        \seq_pop_left:NN \l__guap_cells_seq \l__guap_sym_tl
        \tl_if_in:NnF \l__guap_sym_tl { $ }
          { \tl_set:Nx \l__guap_sym_tl { $ \exp_not:V \l__guap_sym_tl $ } }
        \tl_set:Nx \l__guap_item_tl
          {
            \exp_not:V \l__guap_sym_tl
            \exp_not:N \nobreakspace \exp_not:N \textemdash \c_space_tl
            \seq_use:Nn \l__guap_cells_seq { | }
          }
      }
      { \tl_set:Nn \l__guap_item_tl {#2} }
    \__guap_punct:n {#1}
    \par \noindent
    \hangindent = \box_wd:N \l__guap_where_box
    \hangafter = 1 \scan_stop:
    \int_compare:nNnTF {#1} = { 1 }
      { \box_use:N \l__guap_where_box }
      { \skip_horizontal:n { \box_wd:N \l__guap_where_box } }
    \tl_use:N \l__guap_item_tl
  }

\cs_new_protected:Npn \__guap_eq:nn #1#2
  {
    \begin{equation}
      #2
      \tl_if_blank:nF {#1} { \label{eq:#1} }
    \end{equation}
    \seq_if_empty:NF \g__guap_lines_seq
      {
        \hbox_set:Nn \l__guap_where_box { где \c_space_tl }
        \bool_set_true:N \l__guap_punct_bool
        \seq_map_indexed_function:NN \g__guap_lines_seq \__guap_where_item:nn
        \par
      }
  }

\NewDocumentCommand \guapeq { O{} m }
  { \guap_read_lines:n { \__guap_eq:nn {#1} {#2} } }

%%---------------------------------------------------------------------
%% Список источников: строки под командой — источники по порядку.
%% Пустая строка сразу после команды — берётся biblatex (\printbibliography).
%%---------------------------------------------------------------------
\cs_new_protected:Npn \__guap_sources:
  {
    \guapsection { Список~использованных~источников }
    \seq_if_empty:NTF \g__guap_lines_seq
      { \cs_if_exist:NT \printbibliography { \printbibliography [ heading = none ] } }
      {
        \begin{enumerate} [ label = \arabic*. , wide = \parindent ]
          \seq_map_inline:Nn \g__guap_lines_seq { \item ##1 }
        \end{enumerate}
      }
  }
\NewDocumentCommand \guapsources { }
  { \guap_read_lines:n { \__guap_sources: } }

%%---------------------------------------------------------------------
%% Листинг в тексте:
%%   \begin{code}[Python]{Подпись} ... \end{code}
%%   \begin{code}[Python, main]{Подпись}   — с меткой lst:main
%%   \begin{code}[language=C, firstnumber=10]{Подпись} — любые ключи listings
%%---------------------------------------------------------------------
\int_new:N \l__guap_code_int
\cs_new_protected:cpn { guap@codeopts } #1#2
  {
    \int_zero:N \l__guap_code_int
    \clist_map_inline:nn {#1}
      {
        \tl_if_in:nnTF {##1} { = }
          { \lstset {##1} }
          {
            \int_incr:N \l__guap_code_int
            \int_case:nn { \l__guap_code_int }
              {
                { 1 } { \lstset { language = {##1} } }
                { 2 } { \lstset { label = { lst:##1 } } }
              }
          }
      }
    \lstset { caption = {#2} }
  }
\ExplSyntaxOff

\lstnewenvironment{code}[2][]{\guap@codeopts{#1}{#2}}{}

\endinput
