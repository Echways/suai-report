%%---------------------------------------------------------------------

%%---------------------------------------------------------------------
%% 11. ПРИЛОЖЕНИЯ (ГОСТ 7.32-2017, п. 6.14)
%%  Использование: \guapapp{Название}  или  \guapapp[справочное]{Название}
%%---------------------------------------------------------------------
\newcounter{guapappcnt}
\newcommand{\guapappletter}{\gostupperletter{\value{guapappcnt}}}
\newcommand{\gostupperletter}[1]{%
  \ifcase#1\relax\or А\or Б\or В\or Г\or Д\or Е\or Ж\or И\or К\or Л\or
  М\or Н\or П\or Р\or С\or Т\or У\or Ф\or Х\or Ц\or Ш\or Щ\or Э\or Ю\or Я\fi}

\newcommand{\guapapp}[2][обязательное]{%
  \clearpage
  \stepcounter{guapappcnt}%
  \phantomsection
  \addcontentsline{toc}{section}%
    {\texorpdfstring{ПРИЛОЖЕНИЕ~\guapappletter\ #2}{Прил. #2}}%
  \setcounter{figure}{0}\setcounter{table}{0}%
  \setcounter{equation}{0}\setcounter{lstlisting}{0}%
  \renewcommand{\thefigure}{\guapappletter.\arabic{figure}}%
  \renewcommand{\thetable}{\guapappletter.\arabic{table}}%
  \renewcommand{\theequation}{\guapappletter.\arabic{equation}}%
  \renewcommand{\thelstlisting}{\guapappletter.\arabic{lstlisting}}%
  % уникальные якоря hyperref, иначе ссылки ведут на рисунок 1 из основной части
  \renewcommand{\theHfigure}{app\arabic{guapappcnt}.\arabic{figure}}%
  \renewcommand{\theHtable}{app\arabic{guapappcnt}.\arabic{table}}%
  \renewcommand{\theHequation}{app\arabic{guapappcnt}.\arabic{equation}}%
  \renewcommand{\theHlstlisting}{app\arabic{guapappcnt}.\arabic{lstlisting}}%
  {\centering
   {\guapheadfont ПРИЛОЖЕНИЕ~\guapappletter\par}
   \vspace{2pt}
   {\normalfont(#1)\par}
   \vspace{8pt}
   {\guapheadfont\MakeUppercase{#2}\par}}
  \vspace{14pt}\par
}

%%---------------------------------------------------------------------
%% 12. ТИТУЛЬНЫЙ ЛИСТ ГУАП
%%  Данные: \guapsetup{ключ = значение, ...}, вывод: \maketitle.
%%  Вёрстка снята с официального бланка ГУАП (Word): Times 12 pt,
%%  название работы и дисциплины 14 pt, подписи под линиями 10 pt,
%%  поля титула 30/10/20/20 мм. Расстояния — между базовыми линиями,
%%  в bp (пункты Word), кегли 12.045 pt = 12 bp.
%%---------------------------------------------------------------------
\ExplSyntaxOn
\keys_define:nn { guap }
  {
    department   .tl_set:c = guap@department,
    teacher-post .tl_set:c = guap@teacherpost,
    teacher      .tl_set:c = guap@teacher,
    type         .tl_set:c = guap@type,
    type         .initial:n = Отчет~о~лабораторной~работе,
    number       .tl_set:c = guap@number,
    title        .tl_set:c = guap@title,
    course-label .tl_set:c = guap@courselabel,
    course-label .initial:n = по~курсу:,
    course       .tl_set:c = guap@course,
    group        .tl_set:c = guap@group,
    student      .clist_set:N = \l__guap_students_clist,
    date         .tl_set:c = guap@date,
    city         .tl_set:c = guap@city,
    city         .initial:n = Санкт-Петербург,
    year         .tl_set:c = guap@year,
    year         .initial:x = \int_use:N \c_sys_year_int,
  }
\NewDocumentCommand \guapsetup { m } { \keys_set:nn { guap } {#1} }

% date = today -> текущая дата ДД.ММ.ГГГГ
\cs_new:cpn { guap@thedate }
  {
    \tl_if_eq:cnTF { guap@date } { today }
      {
        \int_compare:nNnT { \c_sys_day_int } < { 10 } { 0 }
        \int_use:N \c_sys_day_int .
        \int_compare:nNnT { \c_sys_month_int } < { 10 } { 0 }
        \int_use:N \c_sys_month_int .
        \int_use:N \c_sys_year_int
      }
      { \use:c { guap@date } }
  }
\cs_new_protected:cpn { guap@forstudents } #1
  { \clist_map_inline:Nn \l__guap_students_clist {#1} }
\cs_new:cpn { guap@firststudent }
  { \clist_if_empty:NF \l__guap_students_clist
      { \clist_item:Nn \l__guap_students_clist { 1 } } }
\ExplSyntaxOff
\makeatletter

% ширина по бланку: #1 из 48135 (= вся ширина строки 481,35 pt)
\newcommand\guap@tw[1]{\dimexpr\textwidth*#1/48135\relax}
% ячейка с линией под текстом
\newcommand\guap@cell[2]{%
  \makebox[#1][c]{#2}\kern-#1\rule[-3.25bp]{#1}{0.5bp}}
% ячейка подписи под линией
\newcommand\guap@cap[2]{\makebox[#1][c]{\fontsize{10.0375}{11.5bp}\selectfont#2}}
% блок: #1 — расстояние от предыдущей базовой линии (glue), #2 — кегль,
% #3 — интерлиньяж при переносе, #4 — выключка, #5 — текст
\newcommand\guap@block[5]{%
  \par\vskip\glueexpr#1-#3\relax
  \begingroup\fontsize{#2}{#3}\selectfont#4#5\par\endgroup}
\newcommand\guap@row[2]{%
  \guap@block{#1}{12.045}{13.8bp}{\noindent}{\makebox[\linewidth][l]{#2}}}

\newcommand{\guaptitlepage}{%
  \newgeometry{left=30mm,right=10mm,top=20mm,bottom=20mm}%
  \thispagestyle{empty}%
  \begingroup
  \def\baselinestretch{1}%
  \setlength{\parindent}{0bp}\setlength{\parskip}{0bp}%
  \setlength{\topskip}{0bp}%
  \lineskiplimit=-\maxdimen \lineskip=0bp
  \hbox{}%
  \guap@block{11.2bp}{12.045}{13.8bp}{\centering}{ГУАП}%
  \guap@block{37.8bp}{12.045}{13.8bp}{\centering}{КАФЕДРА № \guap@department}%
  \guap@block{73.8bp}{12.045}{13.8bp}{\raggedright}{ОТЧЕТ\\ЗАЩИЩЕН С ОЦЕНКОЙ}%
  \guap@block{19.8bp}{12.045}{13.8bp}{\raggedright}{ПРЕПОДАВАТЕЛЬ}%
  \guap@row{26.7bp}{%
    \guap@cell{\guap@tw{16175}}{\guap@teacherpost}\hspace{\guap@tw{1420}}%
    \guap@cell{\guap@tw{14100}}{\guap@thedate}\hspace{\guap@tw{1370}}%
    \guap@cell{\guap@tw{15070}}{\guap@teacher}}%
  \guap@block{10.3bp}{10.0375}{11.5bp}{\noindent}{\makebox[\linewidth][l]{%
    \guap@cap{\guap@tw{16175}}{должность, уч. степень, звание}\hspace{\guap@tw{1420}}%
    \guap@cap{\guap@tw{14100}}{подпись, дата}\hspace{\guap@tw{1370}}%
    \guap@cap{\guap@tw{15070}}{инициалы, фамилия}}}%
  \guap@block{79.0bp minus 30bp}{14.0526}{16.1bp}{\centering}{%
    \MakeUppercase{\guap@type}\ifx\guap@number\@empty\else\ №\guap@number\fi}%
  \guap@block{52.1bp}{14.0526}{16.1bp}{\centering}{\MakeUppercase{\guap@title}}%
  \guap@block{56.2bp}{12.045}{13.8bp}{\centering}{\guap@courselabel}%
  \guap@block{27.7bp}{14.0526}{16.1bp}{\centering}{\guap@course}%
  \guap@block{112bp minus 70bp}{12.045}{13.8bp}{\raggedright}{РАБОТУ ВЫПОЛНИЛ}%
  \def\guap@stskip{26.7bp}%
  \guap@forstudents{%
    \guap@row{\guap@stskip}{%
      \makebox[\guap@tw{10805}][l]{СТУДЕНТ гр. №}%
      \guap@cell{\guap@tw{8660}}{\guap@group}\hspace{\guap@tw{1190}}%
      \guap@cell{\guap@tw{13170}}{\guap@thedate}\hspace{\guap@tw{1180}}%
      \guap@cell{\guap@tw{13130}}{##1}}%
    \guap@block{10.3bp}{10.0375}{11.5bp}{\noindent}{\makebox[\linewidth][l]{%
      \hspace{\guap@tw{10805}}\hspace{\guap@tw{8660}}\hspace{\guap@tw{1190}}%
      \guap@cap{\guap@tw{13170}}{подпись, дата}\hspace{\guap@tw{1180}}%
      \guap@cap{\guap@tw{13130}}{инициалы, фамилия}}}%
    \gdef\guap@stskip{26.7bp}}%
  \guap@block{114.6bp minus 80bp}{12.045}{13.8bp}{\centering}{\guap@city\ \guap@year}%
  \vfill
  \endgroup
  \clearpage
  \restoregeometry
  \setcounter{page}{2}% титул считается, но не нумеруется
}
\renewcommand{\maketitle}{\guaptitlepage}

\AtBeginDocument{%
  \hypersetup{pdftitle={\guap@title}, pdfauthor={\guap@firststudent},
              pdflang={ru-RU}}}

