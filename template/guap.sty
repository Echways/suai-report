%%---------------------------------------------------------------------
%%  4. ЗАГОЛОВКИ (ГОСТ 7.32-2017, п. 6.2)
%%  - структурные элементы (СОДЕРЖАНИЕ, ВВЕДЕНИЕ, ...) — по центру,
%%    прописными, каждый с новой страницы;
%%  - разделы/подразделы — с абзацного отступа, с прописной буквы,
%%    полужирным, без точки в конце.
%%---------------------------------------------------------------------
\RequirePackage{titlesec}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

% без полужирного: \renewcommand{\guapheadfont}{\normalfont\fontsize{14}{17}\selectfont}
\newcommand{\guapheadfont}{\normalfont\fontsize{14}{17}\selectfont\bfseries}

%% Абзацный отступ задаётся внутри метки: \raggedright обнуляет \leftskip,
%% поэтому левый отступ \titlespacing здесь не сработал бы.
\titleformat{\section}[block]
  {\guapheadfont\raggedright}{\hspace*{\parindent}\thesection}{0.6em}{}
\titleformat{\subsection}[block]
  {\guapheadfont\raggedright}{\hspace*{\parindent}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}[block]
  {\guapheadfont\raggedright}{\hspace*{\parindent}\thesubsubsection}{0.6em}{}

\titlespacing{\section}{0pt}{0pt}{14pt}
\titlespacing{\subsection}{0pt}{14pt}{14pt}
\titlespacing{\subsubsection}{0pt}{14pt}{14pt}

% ненумерованные заголовки — по центру, ПРОПИСНЫМИ
\titleformat{name=\section,numberless}[block]
  {\guapheadfont\filcenter}{}{0pt}{\MakeUppercase}
\titlespacing{name=\section,numberless}{0pt}{0pt}{14pt}

\newcommand{\sectionbreak}{\clearpage}   % каждый раздел — с новой страницы

%% Структурный элемент: \guapsection{Введение}
\newcommand{\guapsection}[1]{%
  \clearpage
  \phantomsection
  \section*{#1}%
  \addcontentsline{toc}{section}{\texorpdfstring{\MakeUppercase{#1}}{#1}}%
}

