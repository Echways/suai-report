{
  // Набери префикс и нажми Tab. Работает в .tex файлах.
  // Блоки (список, таблица, формула, источники) заканчиваются ПУСТОЙ строкой.
  "ГУАП: рисунок": {
    "scope": "latex",
    "prefix": ["img", "fig", "рис"],
    "body": [
      "Схема приведена на~\\figref{${1:scheme}}.",
      "",
      "\\guapimg{${1:scheme}}{${2:Подпись без точки}}",
      "$0"
    ]
  },
  "ГУАП: таблица": {
    "scope": "latex",
    "prefix": ["tab", "табл"],
    "body": [
      "Данные приведены в~\\tabref{${1:name}}.",
      "",
      "\\guaptable[${1:name}]{${2:Название таблицы}}",
      "${3:Параметр} | ${4:Значение}",
      "$0",
      ""
    ]
  },
  "ГУАП: задачи": {
    "scope": "latex",
    "prefix": ["tasks", "задачи"],
    "body": ["\\guaptasks", "$0", ""]
  },
  "ГУАП: перечисление а) б) в)": {
    "scope": "latex",
    "prefix": ["enum", "список"],
    "body": ["\\guapenum", "$0", ""]
  },
  "ГУАП: перечисление через дефис": {
    "scope": "latex",
    "prefix": ["list", "item", "дефис"],
    "body": ["\\guaplist", "$0", ""]
  },
  "ГУАП: перечисление 1) 2) 3)": {
    "scope": "latex",
    "prefix": ["num", "нумерация"],
    "body": ["\\guapnum", "$0", ""]
  },
  "ГУАП: формула с пояснениями": {
    "scope": "latex",
    "prefix": ["eq", "формула"],
    "body": [
      "\\guapeq[${1:name}]{${2:y = kx + b}}",
      "${3:y} | ${4:пояснение}",
      "$0",
      ""
    ]
  },
  "ГУАП: код в тексте": {
    "scope": "latex",
    "prefix": ["lst", "листинг"],
    "body": [
      "\\begin{code}[${1|Python,C,C++,Java,SQL,bash,HTML|}]{${2:Подпись}}",
      "$0",
      "\\end{code}"
    ]
  },
  "ГУАП: код из файла": {
    "scope": "latex",
    "prefix": ["code", "код"],
    "body": [
      "\\guapcode[${1|Python,C,C++,Java,SQL,bash,HTML|}]{${2:main.py}}{${3:Подпись}}",
      "$0"
    ]
  },
  "ГУАП: раздел": {
    "scope": "latex",
    "prefix": ["sec", "раздел"],
    "body": ["\\section{${1:Название}}", "", "$0"]
  },
  "ГУАП: источники": {
    "scope": "latex",
    "prefix": ["src", "источники"],
    "body": ["\\guapsources", "$0", ""]
  },
  "ГУАП: приложение": {
    "scope": "latex",
    "prefix": ["app", "прил"],
    "body": ["\\guapapp${1:[справочное]}{${2:Название}}", "", "$0"]
  }
}
