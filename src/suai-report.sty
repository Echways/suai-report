%%=====================================================================
%%  suai-report.sty — отчёт ГУАП по ГОСТ 7.32-2017 / ГОСТ 2.105-2019
%%
%%  Только XeLaTeX. Собирается командой suai build или из VS Code
%%  (аргументы latexmk — в src/vscode/settings.json), в ~/texmf ставится
%%  симлинком через make install. Настройки под методичку пишутся
%%  в преамбуле main.tex, этот файл в отчётах не копируется.
%%
%%   1. Пакеты                     9. Ссылки, \suaiimg, \suaicode
%%   2. Шрифты                    10. Блочные команды: чтение строк
%%   3. Страница и абзац          11. \suailist, \suaienum, \suaitasks
%%   4. Заголовки и содержание    12. \suaitable
%%   5. Подписи, таблицы, списки  13. \suaieq
%%   6. Листинги                  14. \suaisources
%%   7. Приложения                15. Окружение code
%%   8. Титульный лист
%%=====================================================================
\NeedsTeXFormat{LaTeX2e}[2021/11/15]
\ProvidesPackage{suai-report}[2026/09/14 v2.0 SUAI GOST 7.32-2017 report]

\RequirePackage{iftex}
\RequireXeTeX

