%%---------------------------------------------------------------------
%%  2. ШРИФТЫ
%%  Times New Roman — как в бланке ГУАП (титул выверен по нему).
%%  Без него (например, в CI) берётся метрически совместимый TeX Gyre.
%%---------------------------------------------------------------------
\ExplSyntaxOn
\cs_new_protected:Npn \__suai_font:nnnn #1#2#3#4
  {
    \IfFontExistsTF {#2}
      { #1 {#2} [#4] }
      {
        \msg_warning:nnnn { suai } { font } {#2} {#3}
        #1 {#3} [#4]
      }
  }
\msg_new:nnn { suai } { font } { Шрифт~'#1'~не~найден,~используется~'#2' }
\__suai_font:nnnn \setmainfont { Times~New~Roman } { TeX~Gyre~Termes } { }
\__suai_font:nnnn \setsansfont { Liberation~Sans } { TeX~Gyre~Heros } { }
\__suai_font:nnnn \setmonofont { Liberation~Mono } { TeX~Gyre~Cursor }
  { Scale = MatchLowercase }
\ExplSyntaxOff

