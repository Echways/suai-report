% буквы без ё, з, й, о, ч, ъ, ы, ь
\newcommand\suai@lower[1]{%
  \ifcase#1\relax\or а\or б\or в\or г\or д\or е\or ж\or и\or к\or л\or
  м\or н\or п\or р\or с\or т\or у\or ф\or х\or ц\or ш\or щ\or э\or ю\or я\fi}
\newcommand\suai@upper[1]{%
  \ifcase#1\relax\or А\or Б\or В\or Г\or Д\or Е\or Ж\or И\or К\or Л\or
  М\or Н\or П\or Р\or С\or Т\or У\or Ф\or Х\or Ц\or Ш\or Щ\or Э\or Ю\or Я\fi}
\newcommand{\gostletter}[1]{\expandafter\suai@lower\csname c@#1\endcsname}
\AddEnumerateCounter{\gostletter}{\suai@lower}{я}

\newlist{gostenum}{enumerate}{2}
\setlist[gostenum,1]{label=\gostletter*),labelindent=\parindent}
\setlist[gostenum,2]{label=\arabic*),labelindent=2cm}

