{
  // Исходник — src/vscode/settings.json в репозитории шаблона. В отчёты
  // копируется командой suai new / suai update (правки копии затрутся).
  //
  // Сборка: XeLaTeX + Biber, служебное (и PDF с synctex) в build/, готовый
  // PDF копируется рядом с main.tex под именем из двух папок:
  // Databases/lab-3/main.tex -> Databases-lab-3.pdf. suai-report.sty ищется
  // в ~/texmf (suai install). Эти же аргументы использует команда suai build/watch.
  // В строке -e нет ни кавычек, ни команд шелла (PDF копирует сам Perl):
  // так она одинаково работает в Linux, macOS и Windows.
  "latex-workshop.latex.recipes": [
    { "name": "ГУАП (latexmk)", "tools": ["suai-latexmk"] }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "suai-latexmk",
      "command": "latexmk",
      "args": [
        "-e", "$pdf_mode = 5; $bibtex_use = 2; $out_dir = q(build); $xelatex = q(xelatex -synctex=1 -interaction=nonstopmode -file-line-error -halt-on-error %O %S); use Cwd; use File::Copy; my @d = split m{[\\\\/]}, getcwd(); $suai_pdf = qq($d[-2]-$d[-1].pdf); sub suai_copy { copy(qq($out_dir/$root_filename.pdf), $suai_pdf) or warn qq(suai: $suai_pdf: $!\\n); return 0 } $success_cmd = q(internal suai_copy)",
        "%DOC_EXT%"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": ["**/main.tex"],
  "latex-workshop.latex.outDir": "%DIR%/build",

  // Живой предпросмотр: автосохранение -> пересборка -> PDF во вкладке справа
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1200,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 1500,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.view.pdf.zoom": "page-width",

  // Без всплывашек: ошибки видны в панели Problems
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.message.badbox.show": "none",

  // Команды \suai... с аргументами и описанием LaTeX Workshop берёт
  // из .vscode/suai-report.json (копия src/vscode/suai-report.json).
  "latex-workshop.intellisense.package.dirs": ["%WORKSPACE_FOLDER%/.vscode"],
  // Внутри \figref{...} и остальных *ref подсказываются метки из последней
  // сборки: fig:scheme, tab:sync, eq:size, lst:backup. Сборка идёт при
  // каждом автосохранении, так что новая метка появляется через секунду-две.

  "files.exclude": { "**/build": true },
  // Подсказку принимает только Tab, Enter всегда даёт новую строку.
  // Сниппеты — в конце списка: иначе при наборе \it или \begin{eq Tab
  // вставлял бы не \item, а шаблон, чьё имя похоже по буквам. Слова из
  // текста не подсказываются: они забивают список и перехватывают Tab
  // при заполнении ячеек таблицы.
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
    "editor.snippetSuggestions": "bottom",
    "editor.tabCompletion": "onlySnippets",
    "editor.acceptSuggestionOnEnter": "off",
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.snippetsPreventQuickSuggestions": true
  }
}
