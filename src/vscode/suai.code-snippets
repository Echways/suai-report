{
  // Начни набирать команду (\suaita или просто suaita) и нажми Tab.
  // Префикс с \ заменяет набранный слэш, поэтому двойного \\ не будет.
  // Блоки (список, таблица, формула, источники) заканчиваются ПУСТОЙ строкой.
  // Первая табуляция — метка: она же уходит в \figref/\tabref/\lstref/\formref.
  "ГУАП: рисунок": {
    "scope": "latex",
    "prefix": ["\\suaiimg", "img", "рис"],
    "body": [
      "Схема приведена на~\\figref{${1:scheme}}.",
      "",
      "\\suaiimg{${1:scheme}}{${2:Подпись без точки}}",
      "$0"
    ]
  },
  "ГУАП: таблица": {
    "scope": "latex",
    "prefix": ["\\suaitable", "tab", "табл"],
    "body": [
      "Данные приведены в~\\tabref{${1:name}}.",
      "",
      "\\suaitable[${1:name}]{${2:Название таблицы}}",
      "${3:Параметр}  | ${4:Значение}",
      "${5:Процессор} | ${6:8 ядер}",
      "${7:Память}    | ${8:16 ГБ}",
      "$0",
      ""
    ]
  },
  "ГУАП: задачи": {
    "scope": "latex",
    "prefix": ["\\suaitasks", "tasks"],
    "body": [
      "\\suaitasks",
      "${1:изучить теоретический материал}",
      "${2:выполнить практическое задание}",
      "${3:проанализировать результаты}",
      "$0",
      ""
    ]
  },
  "ГУАП: перечисление а) б) в)": {
    "scope": "latex",
    "prefix": ["\\suaienum", "enum"],
    "body": ["\\suaienum", "${1:первый пункт}", "${2:второй пункт}", "$0", ""]
  },
  "ГУАП: перечисление через дефис": {
    "scope": "latex",
    "prefix": ["\\suailist", "list"],
    "body": ["\\suailist", "${1:первый пункт}", "${2:второй пункт}", "$0", ""]
  },
  "ГУАП: перечисление 1) 2) 3)": {
    "scope": "latex",
    "prefix": ["\\suainum", "num"],
    "body": ["\\suainum", "${1:первый шаг}", "${2:второй шаг}", "$0", ""]
  },
  "ГУАП: формула с пояснениями": {
    "scope": "latex",
    "prefix": ["\\suaieq", "eq"],
    "body": [
      "Значение рассчитывается по~\\formref{${1:name}}:",
      "\\suaieq[${1:name}]{${2:y = kx + b}}",
      "${3:y} | ${4:искомая величина}",
      "${5:k} | ${6:коэффициент наклона}",
      "$0",
      ""
    ]
  },
  "ГУАП: код в тексте": {
    "scope": "latex",
    "prefix": ["\\begin{code}", "lst"],
    "body": [
      "Код приведён в~\\lstref{${1:name}}.",
      "",
      "\\begin{code}[${2|Python,C,C++,Java,SQL,bash,HTML|}, ${1:name}]{${3:Подпись}}",
      "$0",
      "\\end{code}"
    ]
  },
  "ГУАП: код из файла": {
    "scope": "latex",
    "prefix": ["\\suaicode", "code"],
    "body": [
      "Код приведён в~\\lstref{${1:name}}.",
      "",
      "\\suaicode[${2|Python,C,C++,Java,SQL,bash,HTML|}]{${3:main.py}}{${4:Подпись}}[lst:${1:name}]",
      "$0"
    ]
  },
  "ГУАП: раздел": {
    "scope": "latex",
    "prefix": ["\\section", "sec"],
    "body": ["\\section{${1:Название}}", "", "$0"]
  },
  "ГУАП: структурный элемент без номера": {
    "scope": "latex",
    "prefix": ["\\suaisection"],
    "body": ["\\suaisection{${1:Название}}", "", "$0"]
  },
  "ГУАП: содержание": {
    "scope": "latex",
    "prefix": ["\\suaitoc", "toc"],
    "body": ["\\suaitoc", "", "$0"]
  },
  "ГУАП: введение": {
    "scope": "latex",
    "prefix": ["\\suaiintro", "intro"],
    "body": ["\\suaiintro", "", "Цель работы — $0"]
  },
  "ГУАП: заключение": {
    "scope": "latex",
    "prefix": ["\\suaiconclusion", "concl"],
    "body": ["\\suaiconclusion", "", "В ходе работы $0"]
  },
  "ГУАП: источники": {
    "scope": "latex",
    "prefix": ["\\suaisources", "src"],
    "body": [
      "\\suaisources",
      "${1:Фамилия И. О. Название. Город: Издательство, 2026. 100 с.}",
      "${2:Название ресурса. URL: https://example.com (дата обращения: ${CURRENT_DATE}.${CURRENT_MONTH}.${CURRENT_YEAR}).}",
      "$0",
      ""
    ]
  },
  "ГУАП: приложение": {
    "scope": "latex",
    "prefix": ["\\suaiapp", "app", "прил"],
    "body": [
      "\\suaiapp[${1|обязательное,рекомендуемое,справочное|}]{${2:Название}}",
      "",
      "$0"
    ]
  },
  "ГУАП: ссылка на рисунок": {
    "scope": "latex",
    "prefix": ["\\figref"],
    "body": ["\\figref{$1}$0"]
  },
  "ГУАП: ссылка на таблицу": {
    "scope": "latex",
    "prefix": ["\\tabref"],
    "body": ["\\tabref{$1}$0"]
  },
  "ГУАП: ссылка на листинг": {
    "scope": "latex",
    "prefix": ["\\lstref"],
    "body": ["\\lstref{$1}$0"]
  },
  "ГУАП: ссылка на формулу": {
    "scope": "latex",
    "prefix": ["\\formref"],
    "body": ["\\formref{$1}$0"]
  }
}
