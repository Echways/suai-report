{
  // Шаблоны «ссылка в тексте + объект»: ГОСТ требует сослаться на каждый
  // рисунок, таблицу, формулу и листинг. Набери img (tab, eq, lst, code)
  // и нажми Tab. Первая табуляция — метка или файл, ссылка над объектом
  // подстраивается сама.
  //
  // Сами команды \suai... подсказывает LaTeX Workshop после «\»: их
  // описание — в suai-report.json рядом.
  "ГУАП: рисунок со ссылкой": {
    "scope": "latex",
    "prefix": ["img", "рис"],
    "body": [
      "Схема приведена на~\\figref{${1/^(?:.*\\/)?(.*?)(?:\\.[^.\\/]*)?$/$1/}}.",
      "",
      "\\suaiimg{${1:scheme}}{${2:Подпись без точки}}",
      "$0"
    ]
  },
  "ГУАП: таблица со ссылкой": {
    "scope": "latex",
    "prefix": ["tab", "табл"],
    "body": [
      "Данные приведены в~\\tabref{${1:name}}.",
      "",
      "\\suaitable[${1:name}]{${2:Название таблицы}}",
      "${3:Параметр}  | ${4:Значение}",
      "${5:Процессор} | ${6:8 ядер}",
      "${7:Память}    | ${8:16 ГБ}",
      "$0",
      ""
    ]
  },
  "ГУАП: формула со ссылкой": {
    "scope": "latex",
    "prefix": ["eq", "форм"],
    "body": [
      "Значение рассчитывается по~\\formref{${1:name}}:",
      "\\suaieq[${1:name}]{${2:y = kx + b}}",
      "${3:y} | ${4:искомая величина}",
      "${5:k} | ${6:коэффициент наклона}",
      "$0",
      ""
    ]
  },
  "ГУАП: код в тексте со ссылкой": {
    "scope": "latex",
    "prefix": ["lst", "лист"],
    "body": [
      "Код приведён в~\\lstref{${1:name}}.",
      "",
      "\\suaicode[${2|Python,C,C++,Java,SQL,bash,HTML|}, ${1:name}]{${3:Подпись}}",
      "    $0",
      ""
    ]
  },
  "ГУАП: код из файла со ссылкой": {
    "scope": "latex",
    "prefix": ["code", "код"],
    "body": [
      "Код приведён в~\\lstref{${2/^(?:.*\\/)?(.*?)(?:\\.[^.\\/]*)?$/$1/}}.",
      "",
      "\\suaicode[${1|Python,C,C++,Java,SQL,bash,HTML|}]{${2:main.py}}{${3:Подпись}}",
      "$0"
    ]
  }
}
